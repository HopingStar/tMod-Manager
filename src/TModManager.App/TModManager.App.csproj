<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TModManager.Core\TModManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- 发布时把仓库根 wwwroot 一并带出（单文件模式 BaseDir=exe 目录，静态文件从 exe 旁 wwwroot 读）。
       ⚠️ 必须排除 static/mod_icons：那是运行时从玩家模组抓取的图标缓存（开发目录里攒了几百个），
       既不该进发布包，更不该被单文件版嵌进 exe。程序启动时会自己重建这个目录。 -->
  <ItemGroup>
    <Content Include="..\..\wwwroot\**\*" Exclude="..\..\wwwroot\static\mod_icons\**" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- GPL-3.0 分发二进制时须随附协议全文：把仓库根的 LICENSE 放到 exe 旁边并打进发布包 -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 构建/发布后删除未使用语言的卫星资源目录（cs/de/es/.../zh-Hant），保持输出目录干净。
       这些目录由 .NET 为多语言资源预留、本项目用不到（当前为空）。用 MSBuild 原生 RemoveDir，无引号转义问题。 -->
  <Target Name="RemoveUnusedSatelliteLangDirs" AfterTargets="Build;Publish">
    <ItemGroup>
      <_UnusedLang Include="cs;de;es;fr;it;ja;ko;pl;pt-BR;ru;tr;zh-Hans;zh-Hant" />
    </ItemGroup>
    <RemoveDir Directories="@(_UnusedLang -> '$(OutDir)%(Identity)')" />
  </Target>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>tModManager</AssemblyName>
    <!-- 程序集元数据（exe 属性 → 详细信息 里能看到）：
         Copyright 同时写明作者与协议，和 LICENSE / SPDX 头保持一致 -->
    <Product>tModManager</Product>
    <Company>HopingStar</Company>
    <Description>tModLoader 多版本与模组管理工具</Description>
    <Copyright>Copyright (C) 2026 HopingStar · GPL-3.0-only</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe 文件图标：由 wwwroot/static/tmod_icon.dat（窗口图标）解密而来，与标题栏图标一致 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 发布时只复制 .pdb，排除 WebView2 等 NuGet 包的 XML 注释文档（省几百 KB） -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

</Project>
